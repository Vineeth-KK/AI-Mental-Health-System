# =====================================================================
# CareAI Environment Configuration (.env.example)
# Copy this file to .env and adjust for your target environment.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Core Flask & Security Settings
# ---------------------------------------------------------------------
APP_ENV=development                       # 'development' for local, 'production' for cloud
FLASK_SECRET_KEY=dev-secret-key-change-in-production
WTF_CSRF_ENABLED=true

# ---------------------------------------------------------------------
# 2. Dual AI Provider Configuration (Ollama Local vs. Groq Cloud)
# ---------------------------------------------------------------------
# Provider selection: 'ollama' (local laptop) or 'groq' (hosted cloud)
AI_PROVIDER=ollama

# [Option A: Local Development - Ollama + Llama 3.2]
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=30.0

# [Option B: Cloud Production - Hosted Groq LLM API]
# On Render: Add these in Render Dashboard -> Environment Variables
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=20.0

# ---------------------------------------------------------------------
# 3. Database Persistence Settings
# ---------------------------------------------------------------------
# Local development uses canonical SQLite by default (leave DATABASE_URL unset):
# SQLALCHEMY_DATABASE_URI=sqlite:///instance/mhapp.db
# Cloud production (PostgreSQL connection string provided automatically by Render):
# DATABASE_URL=postgresql://user:password@host:5432/careai_db

# ---------------------------------------------------------------------
# 4. Optional External Counselor Notifications (SMTP)
# ---------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
