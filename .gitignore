# .gitignore
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
venv/
.venv/
.idea/
.vscode/
*.egg-info/
.pytest_cache/
.cache/

# Environment variables & secrets (never commit secrets)
.env
.env.*
!.env.example

# Database persistence & instances (never commit user data or database files)
instance/
*.db
*.db*
*.sqlite
*.sqlite*
mhapp.db
*.bak

# Vector store data
chroma_db/

# Logs
logs/
*.log

# Large Model Weights (>100MB, excluded from standard git)
*.safetensors
*.pt
*.bin
